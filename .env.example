# ── 공유: API 키 / 접속 정보 ──
OPENAI_API_KEY=""
OLLAMA_BASE="http://localhost:11434"

# ── Transcription ──
TRANSCRIBE_PROVIDER="local"
WHISPER_MODEL_SIZE="large-v3-turbo"
OPENAI_WHISPER_MODEL="whisper-1"
# WHISPER_PROMPT_VERSION=  # 비워두면 prompt 없이 전사. v1: Python 내장함수 힌트

# ── Vision ──
VISION_PROVIDER="local"
OLLAMA_VISION_MODEL="llava"
OPENAI_VISION_MODEL="gpt-4o-mini"

# ── Embedding ──
EMBEDDING_PROVIDER="local"
OLLAMA_EMBED_MODEL="nomic-embed-text"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_DIM="1536"

# ── Chunking ──
# CHUNKING_STRATEGY="fixed"              # "fixed" | "semantic"
# SEMANTIC_BREAKPOINT_PERCENTILE="95.0"  # semantic: 상위 X% 지점을 경계로
# SEMANTIC_MIN_CHUNK_SECONDS="10.0"      # semantic: 청크 최소 길이 (짧은 filler 방지)

# ── QA (Chat) ──
CHAT_PROVIDER="local"
OLLAMA_CHAT_MODEL="llama3.1"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# ── Judge ──
JUDGE_PROVIDER="local"

# ── Correction ──
USE_CORRECTION="false"
CORRECTION_PROVIDER="openai"

# ── Rerank ──
USE_RERANK="false"
RERANK_PROVIDER="llm"  # "llm" | "cohere"
COHERE_API_KEY=""      # rerank_provider=cohere 일 때만 필요
RERANK_MODEL="rerank-multilingual-v3.0"  # rerank_provider=cohere 일 때만 사용
# LLM_RERANK_PROMPT_VERSION="v1"

# ── Hybrid Retrieval (BM25 + vector) ──
USE_HYBRID="true"

# ── HyDE (Hypothetical Document Embeddings) ──
USE_HYDE="true"
# HYDE_PROMPT_VERSION="v1"

# ── Supabase ──
SUPABASE_URL=""
SUPABASE_KEY=""

# ── LangSmith (Tracing) ──
# LANGCHAIN_TRACING_V2=true 일 때만 trace 전송. 키가 비어도 false면 앱은 정상 동작.
LANGCHAIN_TRACING_V2="false"
LANGSMITH_API_KEY=""
LANGCHAIN_PROJECT="pilab-sprint-4"
